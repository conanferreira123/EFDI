# =========================================
# Enterprise Financial Document Intelligence
# Environment Configuration Template
# Copy this file to .env and fill in real values.
# =========================================

# --- Application ---
APP_NAME="Enterprise Financial Document Intelligence"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME

# --- Security / JWT ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Storage ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# --- Bulk Intake (Phase 10) ---
# INTAKE_SCAN_DIR is the only directory the folder-scan intake endpoint
# (POST /documents/intake/scan-folder, ADMIN only) will ever read from.
INTAKE_SCAN_DIR=intake
# Hard ceiling on files processed per bulk-upload or folder-scan request.
MAX_BULK_INTAKE_FILES=100

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- OCR ---
# Options: stub (always works, placeholder output), paddleocr, easyocr.
OCR_DEFAULT_ENGINE=stub

# --- Extraction & LLM ---
EXTRACTION_DEFAULT_ENGINE=hybrid
LLM_PROVIDER=mistral
EXTRACTION_LLM_MODEL=mistral-small-2603
MISTRAL_API_KEY=
MISTRAL_API_BASE=https://api.mistral.ai/v1

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =========================================
# EFDI -- docker-compose environment
# Copy this file to .env (same directory as docker-compose.yml) and
# fill in real values before running `docker compose up`.
#
# This is DIFFERENT from backend/.env.example, which is for running
# the backend directly with `uvicorn` (no Docker). When using Docker
# Compose, only THIS file matters -- docker-compose.yml reads it and
# injects the values into each container's environment itself.
# =========================================

# --- Database ---
POSTGRES_USER=efdi_user
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=efdi

# --- Security ---
# Generate with: openssl rand -hex 32
# The app will not start with the placeholder below -- see
# backend/app/core/config.py's startup check.
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars

# --- Application ---
APP_ENV=production
APP_DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_SIZE_MB=25
MAX_BULK_INTAKE_FILES=100
LOG_LEVEL=INFO

# --- OCR ---
# "stub" works out of the box with no extra setup (placeholder output
# only). Set to "paddleocr" or "easyocr" AND set INSTALL_OCR=true below
# if you need real text recognition.
OCR_DEFAULT_ENGINE=stub
INSTALL_OCR=false

# --- Extraction & LLM ---
EXTRACTION_DEFAULT_ENGINE=hybrid
LLM_PROVIDER=mistral
EXTRACTION_LLM_MODEL=mistral-small-2603
MISTRAL_API_KEY=
MISTRAL_API_BASE=https://api.mistral.ai/v1

# --- CORS ---
# In the default docker-compose setup, the browser only ever talks to
# the frontend's nginx (which proxies to the backend server-to-server),
# so this rarely needs to change. Only relevant if you serve the
# frontend from a different origin than this compose setup provides.
CORS_ORIGINS=http://localhost

# --- Ports ---
# Which host port nginx (the frontend container) binds to. Change if
# port 80 is already in use on your machine.
FRONTEND_PORT=80

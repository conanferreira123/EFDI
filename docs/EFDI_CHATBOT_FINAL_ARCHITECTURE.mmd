%% =====================================================================
%% EFDI CHATBOT FINAL TARGET ARCHITECTURE
%% ReAct Agent Loops, Dual Entry Points, Backend Authorization Boundary,
%% Role-Aware Database & RAG Enforcement, Unified PostgreSQL Engine
%% =====================================================================

    %% -----------------------------------------------------------------
    %% 1. CLIENT & AUTHENTICATION LAYER
    %% -----------------------------------------------------------------
    subgraph Client_Auth ["1. Client & Authentication Layer"]
        User(["User / Client Application"]):::clientNode
        JWTAuth["Existing EFDI JWT Authentication<br/>(OAuth2 Bearer Token / python-jose)"]:::authNode
        UserContext["Trusted Current User Context<br/>- Authenticated user.id<br/>- Assigned user.role<br/>(LLM NEVER trusted with identity or role)"]:::authNode

        User -->|"HTTP Request with Bearer Token"| JWTAuth
        JWTAuth -->|"Decodes & Validates JWT against PostgreSQL Users"| UserContext
    end

    %% -----------------------------------------------------------------
    %% 2. BACKEND AUTHORIZATION BOUNDARY (SECURITY GATEWAY)
    %% -----------------------------------------------------------------
    subgraph Security_Boundary ["2. Backend Authorization Boundary (Trusted Python Security Gateway)"]
        AuthPolicy{"Chat Authorization Policy<br/>(Enforced by Backend, NEVER by LLM)"}:::securityNode

        subgraph Role_Models ["Role-Aware Access Rules"]
            Role_Analyst["FINANCE_ANALYST<br/>- Own documents only: uploaded_by == trusted current_user.id<br/>- Query/aggregate own accessible documents only<br/>- Scoped RAG: chunks from own accessible documents only<br/>- No access to other users' docs or user directory"]:::roleNode
            Role_Manager["FINANCE_MANAGER<br/>- All non-deleted documents across corpus<br/>- Full corpus RAG & relational aggregation<br/>- No unrestricted admin user directory access"]:::roleNode
            Role_Auditor["AUDITOR<br/>- Authorized cross-user read/audit scope<br/>- Read-only cross-user document analysis<br/>- Uploader metadata & document status audits<br/>- No administrative modification rights"]:::roleNode
            Role_Admin["ADMIN<br/>- Broadest visibility: all documents + user records<br/>- User directory, roles, active status, system stats<br/>- Full relational & corpus RAG access"]:::roleNode
        end

        UserContext -->|"Supplies Trusted Identity & Role"| AuthPolicy
        AuthPolicy -.->|"Evaluates"| Role_Analyst
        AuthPolicy -.->|"Evaluates"| Role_Manager
        AuthPolicy -.->|"Evaluates"| Role_Auditor
        AuthPolicy -.->|"Evaluates"| Role_Admin
    end

    %% -----------------------------------------------------------------
    %% 3. GLOBAL CHATBOT SUBSYSTEM (PORTFOLIO-WIDE)
    %% -----------------------------------------------------------------
    subgraph Global_Chatbot ["3. Global-Level Chatbot Subsystem (/api/v1/chat/corpus)"]
        GlobalAPI["Global Chat Router & Session Handler<br/>(POST /chat/corpus/messages)"]:::apiNode
        GlobalAgent["Global ReAct Agent LLM<br/>(Reasoning + Tool Calling Loop)"]:::agentNode

        subgraph Global_Loop ["Iterative ReAct Reasoning Loop"]
            G_Think{"Reason / Decide Next Step"}:::loopNode
            G_Select["Select Tool<br/>(Dynamic, Non-Deterministic)"]:::loopNode
            G_Observe{"Evaluate Observation"}:::loopNode
            G_Answer["Generate Final Grounded Answer"]:::answerNode

            G_Think --> G_Select
            G_Observe -->|"Needs More Info / Multi-Hop"| G_Think
            G_Observe -->|"Sufficient Info"| G_Answer
        end

        AuthPolicy -->|"Permits Scoped Global Query"| GlobalAPI
        GlobalAPI -->|"Initializes Session & State"| GlobalAgent
        GlobalAgent <-->|"Drives Reasoning & Tool Decisions"| Global_Loop
    end

    %% -----------------------------------------------------------------
    %% 4. DOCUMENT-LEVEL CHATBOT SUBSYSTEM (SINGLE DOCUMENT)
    %% -----------------------------------------------------------------
    subgraph Document_Chatbot ["4. Document-Level Chatbot Subsystem (/api/v1/chat/documents/{id})"]
        DocAPI["Document Chat Router<br/>(POST /chat/documents/{document_id}/messages)"]:::apiNode
        DocScopeCheck{"Document Ownership & Access Verification<br/>(Checks user has permission for document_id)"}:::securityNode
        DocAgent["Document-Level ReAct Agent LLM<br/>(Reasoning + Scoped Tool Loop)"]:::agentNode

        subgraph Doc_Loop ["Document Iterative ReAct Loop"]
            D_Think{"Reason / Decide Next Step"}:::loopNode
            D_Select["Select Tool<br/>(RAG or Calculator)"]:::loopNode
            D_Observe{"Evaluate Observation"}:::loopNode
            D_Answer["Generate Final Grounded Answer<br/>(with Chunk Provenance Citations)"]:::answerNode

            D_Think --> D_Select
            D_Observe -->|"Needs More Info"| D_Think
            D_Observe -->|"Sufficient Info"| D_Answer
        end

        AuthPolicy -->|"Permits Document Access"| DocAPI
        DocAPI -->|"Validates Selected Document"| DocScopeCheck
        DocScopeCheck -->|"Authorized: Loads History Context"| DocAgent
        DocScopeCheck -.->|"Unauthorized (Wrong User)"| HTTP403["HTTP 403 Forbidden"]:::errorNode
        DocAgent <-->|"Drives Reasoning & Tool Decisions"| Doc_Loop
    end

    %% -----------------------------------------------------------------
    %% 5. SPECIALIZED BACKEND TOOLS (EXECUTED IN PYTHON)
    %% -----------------------------------------------------------------
    subgraph Backend_Tools ["5. Specialized Backend Tools"]
        %% Tool 1: Calculator
        subgraph Calc_Tool ["Financial Calculator Tool (Deterministic Math)"]
            Calc_Entry["Financial Calculator Tool Interface<br/>(Available to Global & Document Agents)"]:::toolNode
            Calc_Engine["Deterministic Python Decimal Engine<br/>- AST expression evaluation<br/>- Early payment discount formulas<br/>- Calendar deadline date offsets"]:::toolNode

            Calc_Entry --> Calc_Engine
        end

        %% Tool 2: Database Tool
        subgraph DB_Tool ["Global Database / Text-to-SQL Tool"]
            DB_Entry["Database Tool Interface<br/>(Global Agent ONLY)"]:::toolNode
            LLM_Writer["LLM Query Writer<br/>- Receives semantic query intent<br/>- Receives role-aware permitted schema/capability context<br/>- Proposes candidate SQL SELECT<br/>- NEVER receives raw user_id / NEVER decides authorization"]:::llmNode
            SQLGlot_Validation["SQLGlot Validation<br/>1. Enforce SELECT-only (reject all DDL/DML mutations)<br/>2. Validate Table & Column allowlists<br/>3. Enforce forbidden functions blacklist<br/>4. Clamp LIMIT <= 100"]:::securityNode
            Role_Auth_Enforcement["Role-Aware Authorization / Scope Enforcement<br/>(Backend Security Boundary — Uses trusted JWT user.id & role)<br/>- FINANCE_ANALYST: documents.uploaded_by = trusted current_user.id<br/>- FINANCE_MANAGER: all non-deleted documents<br/>- AUDITOR: authorized cross-user read/audit scope<br/>- ADMIN: authorized full document + permitted user/admin scope"]:::securityNode
            DB_Exec["Safe Read-Only DB Executor<br/>- SET TRANSACTION READ ONLY<br/>- SET LOCAL statement_timeout = 5000ms"]:::toolNode

            DB_Entry -->|"Query Intent"| LLM_Writer
            LLM_Writer -->|"Candidate SQL String"| SQLGlot_Validation
            SQLGlot_Validation -->|"Syntactically Valid SQL AST"| Role_Auth_Enforcement
            Role_Auth_Enforcement -->|"Authorized & Scoped SQL AST"| DB_Exec
        end

        %% Tool 3: RAG Tool
        subgraph RAG_Tool_Wrapper ["Document RAG Tool"]
            RAG_Entry["Document RAG Tool Interface<br/>(Available to Global & Document Agents)"]:::toolNode
            RAG_Auth_Scope["RAG Authorization Scope Injector<br/>(Backend Security Boundary — Uses trusted JWT user.id & role)<br/>- Document Chat: verifies access to selected target document_id<br/>- FINANCE_ANALYST: retrieves chunks WHERE uploaded_by == trusted current_user.id<br/>- FINANCE_MANAGER: retrieves from all authorized non-deleted documents<br/>- AUDITOR: retrieves from all authorized audit-scope documents<br/>- ADMIN: retrieves from all authorized documents across corpus"]:::securityNode

            RAG_Entry -->|"Natural Language Query + Target Scope"| RAG_Auth_Scope
        end
    end

    %% -----------------------------------------------------------------
    %% 6. HYBRID RAG RETRIEVAL PIPELINE
    %% -----------------------------------------------------------------
    subgraph RAG_Engine ["6. Hybrid RAG Retrieval Engine (Shared Architecture)"]
        Dense_Search["Dense Vector Search<br/>(384-dim all-MiniLM-L6-v2<br/>PostgreSQL pgvector cosine distance)"]:::ragNode
        Sparse_Search["Sparse Full-Text Search<br/>(PostgreSQL tsvector / tsquery<br/>ts_rank_cd cover density ranking)"]:::ragNode
        RRF["Reciprocal Rank Fusion (RRF)<br/>Score = 1 / (60 + rank)<br/>Fuses Top-30 Dense + Top-30 Sparse -> Top-25"]:::ragNode
        Cross_Encoder["Cross-Encoder Re-Ranker<br/>(ms-marco-MiniLM-L-6-v2)<br/>Deep query-chunk relevance scoring -> Top-5"]:::ragNode

        Dense_Search -->|"Dense Candidates"| RRF
        Sparse_Search -->|"Sparse Candidates"| RRF
        RRF -->|"Fused Candidates"| Cross_Encoder
    end

    %% -----------------------------------------------------------------
    %% 7. UNIFIED POSTGRESQL 16 DATABASE ENGINE (SINGLE DATA STORE)
    %% -----------------------------------------------------------------
    subgraph PostgreSQL_Engine ["7. Unified PostgreSQL 16 Database (Single Store for Relational, Vector & FTS)"]
        subgraph Relational_Data ["Relational Tables"]
            T_Docs[("documents<br/>(id, uploaded_by, status, is_deleted)")]:::dbNode
            T_Users[("users<br/>(id, username, role, is_active)")]:::dbNode
            T_Extract[("extraction_results<br/>(fields JSONB, confidence)")]:::dbNode
            T_Valid[("validation_results<br/>(is_valid, error_count, issues)")]:::dbNode
            T_Class[("classification_results<br/>(predicted_type, confidence)")]:::dbNode
            T_Chat[("chat_sessions & chat_messages<br/>(turns, tool_calls, citations)")]:::dbNode
        end

        subgraph Vector_FTS_Data ["Vector & FTS Storage (document_chunks table)"]
            T_Chunks[("document_chunks<br/>- id, document_id, chunk_type, content<br/>- embedding: Vector(384) [pgvector]<br/>- tsv_content: TSVECTOR [PostgreSQL FTS]")]:::dbNode
        end
    end

    %% -----------------------------------------------------------------
    %% DYNAMIC TOOL INVOCATION & OBSERVATION WIRING
    %% -----------------------------------------------------------------
    
    %% Global Agent Tool Invocations
    G_Select -->|"1. Invoke Math Calculation"| Calc_Entry
    G_Select -->|"2. Invoke Database Query"| DB_Entry
    G_Select -->|"3. Invoke Corpus RAG"| RAG_Entry

    %% Global Observations Returning to Agent Loop
    Calc_Engine -->|"Calculation Observation"| G_Observe
    DB_Exec -->|"SQL Rows Observation"| G_Observe
    Cross_Encoder -->|"Retrieved Chunks Observation"| G_Observe

    %% Document Agent Tool Invocations
    D_Select -->|"1. Invoke Math Calculation"| Calc_Entry
    D_Select -->|"2. Invoke Document RAG"| RAG_Entry

    %% Document Observations Returning to Agent Loop
    Calc_Engine -->|"Calculation Observation"| D_Observe
    Cross_Encoder -->|"Retrieved Chunks Observation"| D_Observe

    %% Backend Authorization Policy wiring to Backend Tools
    AuthPolicy -.->|"Enforces DB Scope via Trusted Context"| Role_Auth_Enforcement
    AuthPolicy -.->|"Enforces RAG Scope via Trusted Context"| RAG_Auth_Scope

    %% Database Tool to PostgreSQL Relational Data
    DB_Exec -->|"Executes Authorized Scoped SQL"| Relational_Data

    %% RAG Scope to Database Search
    RAG_Auth_Scope -->|"Scoped Vector Search"| Dense_Search
    RAG_Auth_Scope -->|"Scoped FTS Search"| Sparse_Search
    Dense_Search <-->|"Queries Vector(384) via pgvector"| T_Chunks
    Sparse_Search <-->|"Queries tsv_content via FTS"| T_Chunks

    %% Session Persistence
    GlobalAPI -.->|"Persists Turn & Tool Logs"| T_Chat
    DocAPI -.->|"Persists Turn & Citations"| T_Chat

    %% -----------------------------------------------------------------
    %% STYLING AND CLASSES
    %% -----------------------------------------------------------------
    classDef clientNode fill:#1e293b,stroke:#0f172a,color:#ffffff,stroke-width:2px;
    classDef authNode fill:#3b82f6,stroke:#1d4ed8,color:#ffffff,stroke-width:2px;
    classDef securityNode fill:#b91c1c,stroke:#7f1d1d,color:#ffffff,stroke-width:3px;
    classDef roleNode fill:#fef2f2,stroke:#ef4444,color:#991b1b,stroke-width:1px;
    classDef apiNode fill:#0284c7,stroke:#0369a1,color:#ffffff,stroke-width:2px;
    classDef agentNode fill:#4f46e5,stroke:#3730a3,color:#ffffff,stroke-width:3px;
    classDef loopNode fill:#eef2ff,stroke:#6366f1,color:#312e81,stroke-width:1px;
    classDef answerNode fill:#059669,stroke:#047857,color:#ffffff,stroke-width:2px;
    classDef toolNode fill:#0d9488,stroke:#0f766e,color:#ffffff,stroke-width:2px;
    classDef llmNode fill:#7c3aed,stroke:#5b21b6,color:#ffffff,stroke-width:2px;
    classDef ragNode fill:#d97706,stroke:#b45309,color:#ffffff,stroke-width:2px;
    classDef dbNode fill:#334155,stroke:#1e293b,color:#ffffff,stroke-width:2px;
    classDef errorNode fill:#991b1b,stroke:#7f1d1d,color:#ffffff,stroke-width:2px;
